.venv/
__pycache__/
*.py[cod]

# Tooling / generated output
.coverage
*.stackdump
artifacts/

# Training corpus stays out of git (Zenodo fetch, not Git LFS).
data/raw/**
!data/raw/.gitkeep
data/processed/**
!data/processed/.gitkeep
data/models/*.onnx
!data/models/active_classifier.onnx
!data/models/active_segmentor.onnx
!data/models/.gitkeep

# Sweep run copies stay local. The written comparison is the git record.
experiments/results/**
!experiments/results/README.md

# Machine-local overnight supervisor with host paths.
experiments/overnight_chain.py

# Design-study local downloads and generated outputs (markdown stays in git).
analysis/**/data/raw/
analysis/**/data/cache/
analysis/**/outputs/**
!analysis/**/outputs/.gitkeep

