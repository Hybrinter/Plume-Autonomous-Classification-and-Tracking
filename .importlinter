[importlinter]
root_packages =
    flight
    sim
    tools
    gse
    analysis

[importlinter:contract:flight-isolation]
name = Flight must not import sim or tools
type = forbidden
source_modules =
    flight
forbidden_modules =
    sim
    tools

[importlinter:contract:sim-isolation]
name = Sim must not import tools
type = forbidden
source_modules =
    sim
forbidden_modules =
    tools

[importlinter:contract:flight-layers]
name = Flight layered architecture
type = layers
layers =
    flight.core
    flight.payload | flight.thermal | flight.electrical | flight.iss_iface | flight.fault
    flight.hal.interfaces
    flight.libs

[importlinter:contract:drivers-from-composition-roots-only]
name = Concrete drivers are reachable only from composition roots
type = forbidden
source_modules =
    flight.payload
    flight.thermal
    flight.electrical
    flight.iss_iface
    flight.fault
    flight.libs
forbidden_modules =
    flight.hal.drivers_real
    flight.hal.drivers_sim

[importlinter:contract:libs-layers]
name = Libs internal layering (messages depend on types; config and telemetry are independent)
type = layers
layers =
    flight.libs.messages
    flight.libs.types

[importlinter:contract:drivers-independent]
name = Real and sim drivers must not import each other
type = forbidden
source_modules =
    flight.hal.drivers_real
forbidden_modules =
    flight.hal.drivers_sim

[importlinter:contract:drivers-independent-reverse]
name = Sim drivers must not import real drivers
type = forbidden
source_modules =
    flight.hal.drivers_sim
forbidden_modules =
    flight.hal.drivers_real

[importlinter:contract:flight-gse-isolation]
name = Flight must not import the ground-support emulator
type = forbidden
source_modules =
    flight
forbidden_modules =
    gse

[importlinter:contract:sim-gse-isolation]
name = Sim must not import the ground-support emulator
type = forbidden
source_modules =
    sim
forbidden_modules =
    gse

[importlinter:contract:analysis-study-independence]
name = Analysis studies must not import sibling studies
type = independence
modules =
    analysis.studies.elevation_controller
    analysis.studies.orin_nano_full_frame_inference
    analysis.studies.single_axis_vs_dual_axis_gimbal
    analysis.studies.tracking_estimator

[importlinter:contract:analysis-isolation]
name = Analysis must not import tools
type = forbidden
source_modules =
    analysis
forbidden_modules =
    tools

[importlinter:contract:flight-analysis-isolation]
name = Flight must not import analysis
type = forbidden
source_modules =
    flight
forbidden_modules =
    analysis

[importlinter:contract:sim-analysis-isolation]
name = Sim must not import analysis
type = forbidden
source_modules =
    sim
forbidden_modules =
    analysis

[importlinter:contract:gse-analysis-isolation]
name = GSE must not import analysis
type = forbidden
source_modules =
    gse
forbidden_modules =
    analysis

[importlinter:contract:original-dataset-isolation]
name = Original dataset analysis must not import flight or inference
type = forbidden
source_modules =
    tools.original_dataset_analysis
forbidden_modules =
    flight
    tools.inference

[importlinter:contract:tools-analysis-isolation]
name = Tools must not import analysis
type = forbidden
source_modules =
    tools
forbidden_modules =
    analysis

[importlinter:contract:ml-models-data-isolation]
name = ml_models data must not import flight inference, flight core, or tools analysis
type = forbidden
source_modules =
    tools.ml_models.data
forbidden_modules =
    flight.payload.inference
    flight.core
    tools.analysis

